{
  "name": "tradieflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:pivot": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pivot-regression-audit.ps1",
    "preflight:production": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-preflight.ps1",
    "preflight:production:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-preflight.ps1 -EnvFile .env.production.local -Strict",
    "verify:local": "npm run lint && npm run typecheck && npm run audit:pivot && npm run build",
    "release:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-gate.ps1",
    "release:gate:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-gate.ps1 -StrictProduction",
    "smoke:production:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-missed-call-smoke-test.ps1 -PreflightOnly",
    "smoke:production:recent": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-missed-call-smoke-test.ps1 -ListRecent",
    "probe:twilio:production": "node scripts/probe-twilio-production.mjs",
    "probe:twilio:production:voice": "node scripts/probe-twilio-production.mjs --voice-probe",
    "smoke:production:missed-call": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-missed-call-smoke-test.ps1",
    "generate-types": "supabase gen types typescript --linked > src/types/database.generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@react-email/components": "1.0.4",
    "@react-email/render": "2.0.2",
    "@stripe/stripe-js": "8.6.1",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.89.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.37.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.562.0",
    "next": "16.2.3",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "14.3.8",
    "recharts": "3.6.0",
    "resend": "6.7.0",
    "sonner": "^2.0.7",
    "stripe": "20.1.2",
    "tailwind-merge": "3.4.0",
    "twilio": "^5.13.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "20.19.27",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.3",
    "supabase": "2.90.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
