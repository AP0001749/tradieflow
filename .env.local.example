# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Baseline checkout uses NEXT_PUBLIC_STRIPE_BASELINE_PRICE_ID first, then falls back to NEXT_PUBLIC_STRIPE_PRO_PRICE_ID
NEXT_PUBLIC_STRIPE_BASELINE_PRICE_ID=price_your_baseline_price_id
NEXT_PUBLIC_STRIPE_APEX_PRICE_ID=price_your_apex_price_id
# Legacy single-plan fallback
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# Site URL (for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_resend_sender
RESEND_SENDER_EMAIL=your_verified_resend_sender
RESEND_REPLY_TO_EMAIL=your_reply_to_email

# Twilio inbound SMS and missed-call text back
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Optional local-only bypass for manual webhook testing. Never enable in production.
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Supabase Edge Function follow-up secret
LEAD_FOLLOWUP_SECRET=your_random_secure_followup_secret
# Optional local Supabase Edge Function URL for smoke-test follow-up probes
LEAD_FOLLOWUP_EDGE_URL=http://localhost:54321/functions/v1/lead-followup
# Optional legacy alias during secret rotation or hosted fallback cutover
CRON_SECRET=your_random_secure_followup_secret

# Upstash Redis (lead rate limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Google Ads
# Conversion ID is configured in src/utils/gtag.ts (AW-17896188158)
# Add your Lead and Subscribe conversion labels from Google Ads -> Tools -> Conversions
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=your_lead_conversion_label
NEXT_PUBLIC_GOOGLE_ADS_SUBSCRIBE_LABEL=your_subscribe_conversion_label
