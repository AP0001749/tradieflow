# Production Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Production app URL
NEXT_PUBLIC_APP_URL=https://your-tradieflow-host

# Optional demo workspace login. Server-only — never prefix these with NEXT_PUBLIC_.
# DEMO_LOGIN_EMAIL=demo@your-tradieflow-host
# DEMO_LOGIN_PASSWORD=a-long-unique-demo-password

# Production lead capture and automation
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=dispatch@your-verified-domain.example
RESEND_SENDER_EMAIL=dispatch@your-verified-domain.example
RESEND_REPLY_TO_EMAIL=reply@your-verified-domain.example
LEAD_FOLLOWUP_SECRET=your_random_secure_followup_secret
# Optional hosted Supabase Edge Function URL for smoke-test follow-up probes.
LEAD_FOLLOWUP_EDGE_URL=https://your-project-ref.functions.supabase.co/lead-followup
# Optional temporary alias while hosted schedulers are cut over.
CRON_SECRET=your_random_secure_followup_secret

# Production Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_BASELINE_PRICE_ID=price_your_299_aud_baseline_monthly_price_id
NEXT_PUBLIC_STRIPE_APEX_PRICE_ID=price_your_499_aud_apex_monthly_price_id
# Optional legacy fallback. Leave blank after Baseline/Apex cutover is verified.
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# Production Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Optional Google Ads conversion labels
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SUBSCRIBE_LABEL=
